# Normalize line endings on checkout regardless of OS (team is on Windows;
# CI runs on Linux) so diffs don't fill with whitespace-only churn.
* text=auto eol=lf

*.py text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh  text eol=lf

# Binary — never diff/merge as text
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pdf binary
*.png binary
*.jpg binary
