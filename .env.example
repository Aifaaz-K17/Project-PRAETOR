# Environment Configuration Template

# API Keys (For mock testing or live LLM integration)
OPENAI_API_KEY=mock-openai-key-for-testing

# Firewall Settings
FIREWALL_MODE=enforce  # Options: enforce, audit_only, disabled
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///firewall_audit.db

# Security Settings
FAIL_SAFE_MODE=fail_closed # Options: fail_closed, fail_open
