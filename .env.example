# Environment Configuration Template

# API Keys (Replace with your actual key for live LLM integration, or leave as-is for mock testing)
OPENAI_API_KEY=your-openai-api-key-here

# Firewall Settings
FIREWALL_MODE=enforce  # Options: enforce, audit_only, disabled
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///firewall_audit.db

# Security Settings
FAIL_SAFE_MODE=fail_closed # Options: fail_closed, fail_open
